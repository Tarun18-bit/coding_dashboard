# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sync Configuration
SYNC_SECRET_TOKEN=generate-a-long-random-string

# Default User Handles
DEFAULT_CODEFORCES_HANDLE=oggy_18
DEFAULT_LEETCODE_USERNAME=txrun_18
DEFAULT_CODECHEF_HANDLE=txrun_18

# App URL (for live badges and share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Reviewer (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Optional: pin a specific model, e.g. gemini-2.5-flash
# GEMINI_MODEL=

# Optional: C++/Java runner via RapidAPI Judge0 CE. Leave unset to use the free public ce.judge0.com (no key needed)
# JUDGE0_API_KEY=
